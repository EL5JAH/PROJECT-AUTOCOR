# =================================================
# Ansible Inventory
# Keep examples tracked, ignore real inventories
# =================================================

# Track main inventory (sanitized)
!ansible/inventory/hosts.yml

# Ignore all group/host vars by default (these may contain secrets)
ansible/inventory/group_vars/*
ansible/inventory/host_vars/*

# Allow example/template files
!ansible/inventory/group_vars/*.example.yml
!ansible/inventory/host_vars/*.example.yml

# Explicitly ignore vault files (even if someone misnames them)
ansible/inventory/group_vars/*vault*
ansible/inventory/host_vars/*vault*